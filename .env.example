# Enterprise Multi-Agent Analytics Assistant Configuration

# Environment configuration
ENVIRONMENT=local # Options: local, docker, production
PORT=8000
HOST=0.0.0.0

# LLM Provider Configuration
# Options: google, openai
LLM_PROVIDER=google
LLM_MODEL=gemini-2.5-flash

# API Keys (REQUIRED — provide at least one based on your chosen LLM_PROVIDER)
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# Optional: Custom OpenAI compatible base URL (e.g., OpenRouter, LiteLLM)
# OPENAI_API_BASE=https://openrouter.ai/api/v1

# Conversation memory depth: number of messages (user+assistant) passed to the LLM.
# 20 = 10 exchanges. Increase for deeper follow-ups, decrease to save tokens.
CONVERSATION_HISTORY_LIMIT=20

# Relational Database Configuration
# In local mode, if Postgres is not running, it automatically falls back to SQLite.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
POSTGRES_DB=analytics_assistant
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis Cache & Memory Configuration
# In local mode, if Redis is not running, it automatically falls back to In-Memory storage.
REDIS_HOST=localhost
REDIS_PORT=6379

# Streamlit UI Configuration
BACKEND_URL=http://localhost:8000
